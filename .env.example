# ==============================================================================
# SPARSH TRADING — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and provide your production credentials before deploying.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SECURITY (CRITICAL)
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection URI (keep username/password secure, never commit to git)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret for admin/customer sessions (MUST be a 64+ char random hex string)
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_cryptographically_secure_random_64_character_hex_secret

# Canonical public production URL of the website (must include https:// and www subdomain)
APP_URL=https://www.sparshtrading.shop

# ------------------------------------------------------------------------------
# 2. DISTRIBUTED RATE LIMITING (BUG-004: Recommended for Vercel Serverless)
# ------------------------------------------------------------------------------
# Optional: Upstash Redis REST credentials for distributed rate limiting across serverless lambdas.
# If omitted, rate limiting falls back seamlessly to the in-memory sliding-window limiter.
# Create free database at: https://console.upstash.com
# UPSTASH_REDIS_REST_URL=https://<your-database>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ------------------------------------------------------------------------------
# 3. WHATSAPP INSTANT LEAD ALERTS (BUG-005: Automated Admin Notification)
# ------------------------------------------------------------------------------
# Target phone number for receiving automated customer lead alerts (Indian 10-digit or with country code)
WHATSAPP_ALERT_PHONE=8795662161

# OPTION A: Generic Webhook (Pabbly Connect / Make / Zapier / Interakt / Wati)
# WHATSAPP_WEBHOOK_URL=https://connect.pabbly.com/workflow/sendwebhookdata/xxxxxx

# OPTION B: UltraMsg WhatsApp Gateway (Popular API in India)
# ULTRAMSG_INSTANCE_ID=instance12345
# ULTRAMSG_TOKEN=your_ultramsg_token

# OPTION C: Meta Official WhatsApp Cloud API
# WHATSAPP_CLOUD_TOKEN=EAAxxxxxxx
# WHATSAPP_PHONE_NUMBER_ID=123456789012345

# ------------------------------------------------------------------------------
# 4. EMAIL DISPATCH (SMTP & LEAD FORWARDING)
# ------------------------------------------------------------------------------
OWNER_EMAIL=mail.sparshtrading@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mail.sparshtrading@gmail.com
# Rotate your Google Account App Password at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_character_gmail_app_password
SMTP_FROM="Sparsh Trading <mail.sparshtrading@gmail.com>"

# Free fallback email forwarding endpoint
FREE_FORM_ENDPOINT=https://formsubmit.co/ajax/mail.sparshtrading@gmail.com

# ------------------------------------------------------------------------------
# 5. STORAGE & TAX CONFIGURATION
# ------------------------------------------------------------------------------
UPLOAD_DIR=public/uploads
TAX_DEFAULT_RATE=0

# ------------------------------------------------------------------------------
# 6. INITIAL ADMIN CREDENTIALS (OFFLINE STORE SEED)
# ------------------------------------------------------------------------------
# Required for initial offline administrative user creation (never hardcoded in source)
ADMIN_INITIAL_PASSWORD=choose_a_strong_random_admin_password_here
ADMIN_INITIAL_PHONE=8795662161
